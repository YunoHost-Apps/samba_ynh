#!/bin/bash
# In simple cases, you don't need a config script.

# With a simple config_panel.toml, you can write in the app settings, in the
# upstream config file or replace complete files (logo ...) and restart services.

# The config scripts allows you to go further, to handle specific cases
# (validation of several interdependent fields, specific getter/setter for a value,
# display dynamic informations or choices, pre-loading of config type .cube... ).

source /usr/share/yunohost/helpers

data_dir=$(ynh_app_setting_get --key=data_dir)
install_dir=$(ynh_app_setting_get --key=install_dir)

#=================================================
# recreate the smb.conf from smb.conf.d
#=================================================
write_smb_conf() {
    cat > $install_dir/smb.conf <<EOF
# =================================================
# DO NOT EDIT THIS FILE
# EDIT SUBPARTS IN /etc/samba/smb.conf.d
# =================================================

EOF
    cat $install_dir/smb.conf.d/*.conf >> $install_dir/smb.conf
}

validate__directories() {
    declare -A errors=()
    # errors_index is needed to ensure languages appearance order as associative arrays ($errors) can't be ordered by declared keys
    local usernames=$(ynh_user_list) errors_index=("en" "fr") hasAlreadyUnauthorizedCharactersError hasAlreadyUsernameError message=""
    for directory in $(echo $directories | sed "s/,/ /g"); do
        if [[ ! "$directory" =~ ^[a-z0-9_]+$ && ! "${hasAlreadyUnauthorizedCharactersError-}" ]]; then
            hasAlreadyUnauthorizedCharactersError=true
            errors["en"]="- Directories names can only contain lowercase alphabetic characters, numbers and underscores.\n${errors["en"]-}"
            errors["fr"]="- Les noms de dossiers ne peuvent contenir que des lettres, des chiffres et des tirets bas (_).\n${errors["fr"]-}"
        fi
        regex=\\b$directory\\b
        if [[ "$usernames" =~ $regex && ! "${hasAlreadyUsernameError-}" ]]; then
            hasAlreadyUsernameError=true
            errors["en"]="${errors["en"]-}- Directories names can't be the same as a username.\nReminder: every user already gets, by default, a shared directory bearing its name.\n"
            errors["fr"]="${errors["fr"]-}- Les dossiers ne peuvent porter le même nom qu'un utilisateur.\nRappel : Par défaut, chaque utilisateur bénéficie déjà d'un dossier partagé portant son nom.\n"
        fi
    done
    if [[ ${#errors[@]} -ne 0 ]]; then
        errors["en"]="<b>[EN]</b> The following errors were raised while saving your changes:\n${errors["en"]}"
        errors["fr"]="<b>[FR]</b> La ou les erreurs suivantes ont été levées lors de la sauvegarde de vos modifications :\n${errors["fr"]}"
        for key in "${errors_index[@]}"; do
            message+="${errors[$key]}"
        done
        echo "$message"
    fi
}

#=================================================
# SPECIFIC SETTERS FOR TOML SHORT KEYS
#=================================================
set__directories() {

    mkdir -p $install_dir/smb.conf.d

    #---------------------------------------------
    # IMPORTANT: setter are trigger only if a change is detected
    #---------------------------------------------
    for directory in $(echo $directories | sed "s/,/ /g"); do

        # Create yunohost permission
        if ! ynh_permission_exists --permission=$directory ; then
            ynh_permission_create --permission="$directory" --allowed=all_users --show_tile=false
        fi

        # Create the directory
        mkdir -p $data_dir/$directory

        chmod 750 "$data_dir/$directory"
        chmod -R o-rwx "$data_dir/$directory"
        chown -R root:root "$data_dir/$directory"
        setfacl -R -m g:samba.$directory:rwx,d:g:samba.$directory:rwx $data_dir/$directory

        # Add the configuration in /etc/samba/smb.conf.d/ if its missing
        if [ ! -f "$install_dir/smb.conf.d/$directory.conf" ]; then
            cat > $install_dir/smb.conf.d/$directory.conf <<END
[$directory]
   comment = $directory
   read only = no
   path = $data_dir/$directory
   guest ok = no
   browsable = yes
   valid users = @samba.$directory
   create mask = 0660
   directory mask = 770
   vfs objects = acl_xattr recycle
   recycle:repository = .recycle
   recycle:keeptree = yes
   recycle:versions = yes
END
        fi

    done

    # Remove configuration for unlisted directories
    for directory in $(find $install_dir/smb.conf.d/ -maxdepth 1 -type f -not -name '0-global.conf' -exec basename {} \;); do
        if ! [[ "${directory%.conf}" =~ $(echo "^($(echo $directories | sed 's/,\| /|/g'))$") ]]; then
            ynh_safe_rm "$install_dir/smb.conf.d/$directory"
        fi
    done

    write_smb_conf

#---------------------------------------------
# IMPORTANT: to be able to upgrade properly, you have to save the value in settings too
#---------------------------------------------
    ynh_app_setting_set --app="$app" --key=directories --value="$directories"
}

set__readonly_dir() {
    local value
    for directory in $(echo $directories | sed "s/,/ /g"); do
        value="no"
        if [[ -n "$readonly_dir" && $directory =~ $(echo "^($(echo $readonly_dir | sed 's/,\| /|/g'))$") ]]; then
            value="yes"
        fi
        ynh_write_var_in_file --file=$install_dir/smb.conf.d/$directory.conf --key=read[[:space:]]only --value="$value"
    done
    ynh_app_setting_set --app="$app" --key=readonly_dir --value="$readonly_dir"
    write_smb_conf
}

set__unbrowseable() {
    local value
    for directory in $(echo $directories | sed "s/,/ /g"); do
        value="yes"
        if [[ -n "$unbrowseable" &&  $directory =~ $(echo "^($(echo $unbrowseable | sed 's/,\| /|/g'))$") ]]; then
            value="no"
        fi
        ynh_write_var_in_file --file=$install_dir/smb.conf.d/$directory.conf --key="browsable" --value="$value"
    done
    ynh_app_setting_set --app="$app" --key=unbrowseable --value="$unbrowseable"
    write_smb_conf
}

#=================================================
ynh_app_config_run $1
